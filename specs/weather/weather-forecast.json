                          }
                        }
                      }
                    }
                  },
                  "hourlyPrecision": {
                    "summary": "precision=hourly response",
                    "value": {
                      "location": {
                        "location_string": "Lahore",
                        "country_name": "Pakistan",
                        "state_prov": "Punjab",
                        "city": "Lahore",
                        "locality": "",
                        "latitude": "31.56568",
                        "longitude": "74.31418",
                        "elevation": "",
                        "timezone": "Asia/Karachi",
