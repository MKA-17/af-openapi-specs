                      },
                      "forecast": {
                        "2026-07-24": {
                          "hourly": [
                            {
                              "timestamp": "2026-07-24T00:00",
                              "temperature_2m": 27.3,
                              "relative_humidity_2m": 84,
                              "dew_point_2m": 24.4,
                              "apparent_temperature": 32.4,
                              "precipitation_probability": 40,
                              "precipitation": 0,
                              "rain": 0,
                              "showers": 0,
                              "snowfall": 0,
                              "weather_code": 3,
                              "pressure_msl": 1000.9,
                              "surface_pressure": 976.9,
                              "cloud_cover": 98,
                              "visibility": 7740,
                              "et0_fao_evapotranspiration": 0.01,
                              "wind_speed_10m": 8.4,
                              "wind_direction_10m": 74,
                              "wind_gusts_10m": 16.2,
                              "uv_index": 0,
