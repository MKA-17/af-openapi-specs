                            {
                              "name": "google.com",
                              "type": 28,
                              "dnsType": "AAAA",
                              "ttl": 106,
                              "rawText": "google.com.\t\t106\tIN\tAAAA\t2a00:1450:4025:401:0:0:0:8b",
                              "rRsetType": 28,
