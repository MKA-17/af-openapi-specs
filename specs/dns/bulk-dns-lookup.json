                            {
                              "name": "google.com",
                              "type": 1,
                              "dnsType": "A",
                              "ttl": 266,
                              "rawText": "google.com.\t\t266\tIN\tA\t142.250.27.100",
                              "rRsetType": 1,
                              "address": "142.250.27.100"
                            },
                            {
                              "name": "google.com",
                              "type": 1,
                              "dnsType": "A",
                              "ttl": 266,
                              "rawText": "google.com.\t\t266\tIN\tA\t142.250.27.101",
