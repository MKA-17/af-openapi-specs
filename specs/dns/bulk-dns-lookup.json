                        },
                        {
                          "status": true,
                          "queryTime": "2026-06-17 09:43:40",
                          "domainName": "example.com",
                          "domainRegistered": true,
                          "dnsTypes": {
                            "A": 1,
                            "NS": 2,
                            "SOA": 6,
