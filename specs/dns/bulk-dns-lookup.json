                },
                "examples": {
                  "payloadTooLarge": {
                    "summary": "More than 100 domain names submitted",
                    "value": {
                      "error": "Payload too large Exception",
                      "message": "Maximum request body size limit exceeded",
                      "path": "/v1.0/domain/dns/live",
                      "status": 413,
                      "timestamp": "2026-07-23T09:52:49.621Z"
                    }
                  }
